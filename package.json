{
  "name": "finaluchi-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --prefix frontend && node -e \"const fs = require('fs'); fs.cpSync('frontend/dist', 'dist', { recursive: true });\"",
    "dev": "npm run dev --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build:backend": "npm run build --prefix backend"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
