# Frontend Environment Variables Template
VITE_API_URL=http://localhost:5000
VITE_SITE_URL=https://finaluchi.com
VITE_APP_NAME="FINALUCHI COUTURE"

# Paystack PUBLIC key (pk_test_… while testing, pk_live_… for go-live).
# Use this exact name in the frontend Vercel project. The legacy
# VITE_PAYSTACK_PUBLIC_KEY is also supported. Never put the SECRET key here.
# Set the key for each Vercel environment you deploy to, then redeploy.
# Setup steps: docs/LAUNCH_RUNBOOK.md §1
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
