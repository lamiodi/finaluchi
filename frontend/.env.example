# Frontend Environment Variables Template
VITE_API_URL=http://localhost:5000
VITE_SITE_URL=https://finaluchi.com
VITE_APP_NAME="FINALUCHI COUTURE"

# Paystack PUBLIC key (pk_test_… while testing, pk_live_… for go-live).
# While this value is unset or a placeholder, checkout automatically uses the
# WhatsApp concierge flow; the moment a real key is present the storefront
# switches to the Paystack secure popup. Never put the SECRET key here.
# Setup steps: docs/LAUNCH_RUNBOOK.md §1
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
