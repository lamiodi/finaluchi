PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
SITE_URL=https://finaluchi.com

# Atelier Admin Desk
# Studio passcode for the /admin order desk (set a strong one before go-live)
ADMIN_PASSCODE=
# Optional separate secret for signing admin session tokens (defaults to ADMIN_PASSCODE)
ADMIN_TOKEN_SECRET=

# Transactional Email (Resend — https://resend.com)
# 1. Verify your domain (e.g. finaluchi.com) in Resend
# 2. Create an API key and paste it below
# 3. Set RESEND_FROM to a verified sender, e.g. "FINALUCHI COUTURE <orders@finaluchi.com>"
# Until configured, emails are logged to the server console instead of sent.
RESEND_API_KEY=
RESEND_FROM=FINALUCHI COUTURE <onboarding@resend.dev>
# Where the studio receives new-order / appointment / inquiry notifications
ATELIER_EMAIL=

# Paystack Configuration (https://paystack.com — full setup: docs/LAUNCH_RUNBOOK.md §1)
# SECRET key stays server-side only. While these are placeholders:
#   - POST /api/payments/verify returns 503 (gateway not configured)
#   - the webhook fails closed (no event is trusted)
# PAYSTACK_WEBHOOK_SECRET defaults to your secret key (Paystack signs with sk_…).
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here

# Storage: JSON file location (defaults to ./data). Point at a persistent
# volume on your host, or migrate to Supabase/Neon for durable cloud storage
# (docs/LAUNCH_RUNBOOK.md §3). Never deploy to ephemeral serverless storage
# without migrating first.
# DATA_DIR=/var/data/finaluchi

# Database Configuration (PostgreSQL — Supabase/Neon)
# Supabase: Dashboard → Connect → copy the connection string into backend/.env.
# Percent-encode special characters in the password.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres

# Cloudinary (image storage & CDN — https://cloudinary.com)
# Full credential URL from Cloudinary Dashboard → Settings → Access Keys
# (the SDK and upload scripts read this single variable)
# CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
